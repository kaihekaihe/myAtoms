# ===== LLM（OpenAI 兼容接口）=====
# 不配置 LLM_API_KEY 时，生成流水线自动降级为内置规则引擎（界面会明确提示）。
# 三种常见选择（任选其一，取消注释并填入 Key）：

# [推荐·国内·免费] 智谱 GLM-5.3-Flash（bigmodel.cn 注册即得 Key，V0 档带免费并发额度）
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_MODEL=glm-5.3-flash
# 注：GLM-5.3 系列强制思考，无需额外参数（推理走独立 reasoning_content 字段）；
#     思考 token 计入输出额度，建议 LLM_MAX_TOKENS=8000

# [免费层·海外] Google Gemini（aistudio.google.com 申请 Key，模型名以免费列表为准）
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-2.5-flash

# [免费层·海外] Groq（console.groq.com，速度快）
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-120b

# [付费但便宜] DeepSeek
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-flash

LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_MS=90000
LLM_MAX_TOKENS=4096
# 可选：附加请求参数（JSON 对象），用于供应商特有的开关
LLM_EXTRA_BODY=

# ===== 存储 =====
# 本地默认 ./data/atomlab.db（自动创建）。
# 云端部署请指向持久化磁盘，例如 /data/atomlab.db
DB_PATH=./data/atomlab.db

# ===== 其他 =====
# 分享链接的外网地址前缀；不填则按当前请求的 host 自动推导
PUBLIC_BASE_URL=